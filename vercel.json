{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express"
    },
    "lab-three": {
      "root": "lab-03",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/lab-03",
      "destination": {
        "service": "lab-three"
      }
    },
    {
      "source": "/lab-03/(.*)",
      "destination": {
        "service": "lab-three"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
